# ==========================
# Database
# ==========================

POSTGRES_DB=cscrs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD

DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@postgres:5432/cscrs

# ==========================
# JWT
# ==========================

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================
# Super Admin Bootstrap
# ==========================

INITIAL_SUPER_ADMIN_EMAIL=superadmin@gmail.com
INITIAL_SUPER_ADMIN_PASSWORD=YOUR_STRONG_SUPER_ADMIN_PASSWORD

# ==========================
# Email
# ==========================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=abhishek34656srmu@gmail.com
SMTP_PASSWORD=
MAIL_FROM=abhishek34656srmu@gmail.com

# ==========================
# OTP & Account Security
# ==========================

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# ==========================
# URLs
# ==========================

APP_BASE_URL=https://api.cscrs.tech
FRONTEND_BASE_URL=https://cscrs.tech

# ==========================
# Worker Invitation
# ==========================

WORKER_INVITATION_EXPIRY_HOURS=24

# ==========================
# Duplicate Detection
# ==========================

DUPLICATE_REPORT_RADIUS_METERS=8
DUPLICATE_ENABLE_SCENE_CHECK=True
DUPLICATE_SCENE_THRESHOLD=0.82

# ==========================
# Start Work
# ==========================

START_WORK_RADIUS_METERS=30

# ==========================
# Redis
# ==========================

REDIS_URL=redis://redis:6379/0

ENABLE_API_DOCS=True

# ==========================
# Logging
# ==========================

LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
 
# ==========================
# Data Retention
# ==========================
LOGIN_AUDIT_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_MAX_UNREAD_RETENTION_DAYS=365
REFRESH_TOKEN_RETENTION_DAYS=0
RETENTION_BATCH_SIZE=1000
ENABLE_RETENTION_SCHEDULER=False
RETENTION_SCHEDULER_INTERVAL_HOURS=24

# ==========================
# Object Storage (OCI)
# ==========================
OBJECT_STORAGE_PROVIDER=oci
OCI_OBJECT_STORAGE_REGION=ap-mumbai-1
OCI_OBJECT_STORAGE_NAMESPACE=bmv2paypbavo
OCI_OBJECT_STORAGE_BUCKET=cscrs-storage

OCI_OBJECT_STORAGE_TENANCY_OCID=ocid1.tenancy.oc1..YOUR_TENANCY_OCID
OCI_OBJECT_STORAGE_USER_OCID=ocid1.user.oc1..YOUR_USER_OCID
OCI_OBJECT_STORAGE_FINGERPRINT=YOUR_KEY_FINGERPRINT
OCI_OBJECT_STORAGE_KEY_FILE=/secrets/oci/oci_api_key.pem
OCI_OBJECT_STORAGE_KEY_PASSPHRASE=

OBJECT_STORAGE_PREFIX=cscrs/v1
MEDIA_SERVING_MODE=stream
MEDIA_PAR_EXPIRES_SECONDS=900

# Canonical Image Processing
CANONICAL_IMAGE_MAX_DIMENSION=2048
CANONICAL_IMAGE_WEBP_QUALITY=85
CANONICAL_IMAGE_MAX_PIXELS=50000000